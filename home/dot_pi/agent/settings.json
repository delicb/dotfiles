{
  "lastChangelogVersion": "0.99.2",
  "compaction": {
    "enabled": true
  },
  "worktrees": {
    "default": "ask",
    "repositories": {
      "~/work/linear-app": "always",
      "~/src/mementry": "always",
      "~/.local/share/chezmoi": "ask"
    }
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": true,
  "enableSkillCommands": true,
  "packages": [
    "npm:pi-screenshots-picker",
    "./packages/compact-tools",
    "npm:@aliou/pi-guardrails",
    "./packages/rtk-rewrite",
    "./packages/pi-worktrees",
    "./packages/pi-handover",
    "./packages/pi-mcp-config",
    "npm:@aliou/pi-dev-kit",
    "./packages/pi-footer",
    "npm:pi-web-access",
    "npm:@aliou/pi-processes",
    "npm:pi-interactive-shell",
    "npm:pi-btw"
  ],
  "extensions": [
    "-builtin:mcp"
  ],
  "theme": "catppuccin-mocha-contrast",
  "showHardwareCursor": true,
  "followUpMode": "one-at-a-time",
  "steeringMode": "one-at-a-time",
  "transport": "auto",
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "collapseChangelog": true,
  "kendex": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-tool-renderer": {
          "compactUserMessages": false
        }
      }
    }
  },
  "pi-screenshots": {
    "sources": [
      "~/Documents/Screenshots/*.png",
      "~/Desktop"
    ]
  },
  "tuiMode": "fullscreen",
  "outputPad": 1
}