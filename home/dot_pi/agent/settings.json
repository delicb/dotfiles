{
  "lastChangelogVersion": "0.85.1",
  "compaction": {
    "enabled": true
  },
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": true,
  "packages": [
    "npm:pi-screenshots-picker",
    "npm:@vanillagreen/pi-tool-renderer",
    "npm:@aliou/pi-guardrails",
    "./packages/rtk-rewrite",
    "npm:pi-mcp-adapter",
    "npm:@aliou/pi-dev-kit",
    "npm:pi-powerline-footer",
    "npm:pi-web-access",
    "npm:@aliou/pi-processes",
    "npm:pi-interactive-shell",
    "npm:pi-btw"
  ],
  "workingVibe": "hpmor",
  "workingVibeMode": "file",
  "projectSkillPaths": [
    ".claude/skills"
  ],
  "theme": "catppuccin-mocha-contrast",
  "showHardwareCursor": true,
  "followUpMode": "one-at-a-time",
  "steeringMode": "one-at-a-time",
  "transport": "auto",
  "quietStartup": true,
  "doubleEscapeAction": "tree",
  "collapseChangelog": true,
  "powerline": {
    "preset": "default",
    "mouseScroll": false,
    "fixedEditor": false
  },
  "kendex": {
    "extensionManager": {
      "config": {
        "@vanillagreen/pi-tool-renderer": {
          "compactUserMessages": false
        }
      }
    }
  },
  "pi-screenshots": {
    "sources": [
      "~/Documents/Screenshots/*.png",
      "~/Desktop"
    ]
  },
  "tuiMode": "fullscreen",
  "outputPad": 1
}