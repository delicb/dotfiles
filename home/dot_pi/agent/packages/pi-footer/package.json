    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@earendil-works/pi-tui": "0.99.2",
    "@biomejs/biome": "2.4.15",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "scripts": {
    "test": "vitest run --reporter=agent",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
