{
  "name": "@del-boy/pi-mcp-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Load shared MCP definitions with global Pi overrides",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "pi": {
    "extensions": [
      "./extensions/mcp-config/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@earendil-works/pi-coding-agent": "0.99.2",
    "@types/node": "22.19.19",
    "@types/proper-lockfile": "4.1.4",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "scripts": {
    "lint": "biome check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@12.4.1"
}
