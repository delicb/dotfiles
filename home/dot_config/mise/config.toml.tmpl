{{- if not .ephemeral -}}
[tools]
go = "latest"
sqlite = "latest"
httpie-go = "latest"
awscli = "latest"
shellcheck = "latest"
just = "latest"
usage = "latest"
uv = "latest"
xh = "latest"
"npm:@earendil-works/pi-coding-agent" = "latest"
"npm:wrangler" = "latest"
{{ if .include_Linear -}}
node = "24.16.0"
"npm:pnpm" = "latest"
"npm:@opencode-ai/cli" = "next"
"npm:zapier-platform-cli" = "latest"
bun = ["latest", "1.3.13"]
rust = "1.92.0"
terraform = "latest"
{{ else }}
node = "latest"
{{ end }}
{{ end -}}

[settings]
{{ if not .ephemeral -}}
legacy_version_file = false
experimental = false
raw = true
python.uv_venv_auto = false
python.compile = true
{{ end -}}
hook_env.chpwd_only = true
hook_env.cache_ttl = "10s"
fetch_remote_versions_cache = "24h"
prefer_offline = true
